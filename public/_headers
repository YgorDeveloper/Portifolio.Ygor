# Cabeçalhos servidos pela Cloudflare (Pages / Workers Assets).
# Este arquivo é copiado para `out/` no build e lido automaticamente.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Assets versionados por hash — podem ser cacheados para sempre.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# As imagens de metadados do Next são geradas sem extensão no arquivo;
# o Content-Type precisa ser declarado aqui para que WhatsApp, LinkedIn e
# demais crawlers reconheçam a prévia.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

/apple-icon
  Content-Type: image/png
  Cache-Control: public, max-age=86400
